---
import type { ComponentProps } from 'astro/types';
import BlumeLogo from 'blume/components/layout/Logo.astro';
import { version } from '../../packages/ui/package.json';

type Props = ComponentProps<typeof BlumeLogo>;
---

<div class="ds-brand">
  <BlumeLogo {...Astro.props} />
  <span class="ds-version" aria-label={`Package version ${version}`}>v{version}</span>
</div>

<style>
  .ds-brand {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 8px;
  }

  .ds-version {
    flex-shrink: 0;
    color: var(--blume-muted-foreground);
    font-size: 11px;
    white-space: nowrap;
  }

  @media (max-width: 639px) {
    .ds-brand {
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
    }
  }
</style>
