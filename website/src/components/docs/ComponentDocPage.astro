---
import { Code as AstroCode } from "astro:components";
import { Code as EcCode } from "@astrojs/starlight/components";
import type { ComponentDoc, ControllerRow, EventRow, SlotReference } from "../../data/component-docs";
import DocTable from "./DocTable.astro";

interface Props {
  doc: ComponentDoc;
}

const { doc } = Astro.props;

const installCode = `npm install ${doc.packageName}`;
const createCode = `import { ${doc.createFn} } from "${doc.packageName}";

const controller = ${doc.createFn}(root);`;

const controllerRows = doc.controller ?? [];
const outboundEvents = (doc.events ?? []).filter((event) => event.direction === "outbound");
const inboundEvents = (doc.events ?? []).filter((event) => event.direction === "inbound");

const hasRows = (rows?: unknown[]) => Array.isArray(rows) && rows.length > 0;
const slotId = (slot: SlotReference) => `slot-${slot.name}`;
const controllerLabel = (entry: ControllerRow) =>
  entry.kind === "property" ? `${entry.name} (property)` : `${entry.name}()`;
const statusLabel = (slot: SlotReference) => `${slot.status} · ${slot.authored}`;
const eventLabel = (event: EventRow) =>
  event.direction === "outbound" ? `${event.name}` : `${event.name}`;
const parseName = (raw: string) => {
  const match = raw.match(/^(.+?)\s*\/\s*(data-.+)$/);
  if (match) return { prop: match[1].trim(), dataAttr: match[2].trim() };
  return { prop: raw, dataAttr: null };
};

const inlineParts = (value: string) =>
  value.split(/(`[^`]+`)/g).filter(Boolean).map((part) => ({
    code: part.startsWith("`") && part.endsWith("`"),
    text: part.startsWith("`") && part.endsWith("`") ? part.slice(1, -1) : part,
  }));
const slotMarkup = (slot: SlotReference) => {
  const tagMatch = slot.element.match(/^<([a-z0-9-]+)([^>]*)>/i);
  const tagName = tagMatch?.[1] ?? "div";
  const rawAttrs = tagMatch?.[2]?.trim() ?? "";
  const attrs = rawAttrs.length > 0 ? ` ${rawAttrs}` : "";

  if (/data-slot\s*=/.test(attrs)) {
    return `<${tagName}${attrs}></${tagName}>`;
  }

  return `<${tagName} data-slot="${slot.name}"${attrs}></${tagName}>`;
};
---

{doc.overview.map((paragraph) => <p>{paragraph}</p>)}

<slot name="hero" />

<h2 id="anatomy">Anatomy</h2>
{doc.anatomy.map((paragraph) => <p>{paragraph}</p>)}
{doc.anatomyMarkup && (
  <div class="anatomy-markup not-content">
    <EcCode code={doc.anatomyMarkup} lang="html" meta="slot-links" frame="none" />
  </div>
)}

<h2 id="examples">Examples</h2>
{doc.examples.map((paragraph) => <p>{paragraph}</p>)}
<slot />

<h2 id="styling">Styling</h2>
{doc.styling.map((paragraph) => <p>{paragraph}</p>)}

<h2 id="accessibility">Accessibility</h2>
{doc.accessibility.map((paragraph) => <p>{paragraph}</p>)}

<h2 id="api-reference">API Reference</h2>

<div class="api-shell not-content">
  <div>
    <p class="api-shell-label">Install</p>
    <EcCode code={installCode} lang="bash" frame="none" />
  </div>
  <div>
    <p class="api-shell-label">Create a controller</p>
    <EcCode code={createCode} lang="ts" frame="none" />
  </div>
</div>

{doc.optionPrecedence && <p>{doc.optionPrecedence}</p>}

<nav class="slot-index not-content" aria-label="Slots">
  {doc.slots.map((slot, i) => (
    <>{i > 0 && <span class="slot-index-sep" aria-hidden="true">·</span>}<a href={`#${slotId(slot)}`}><code>{slot.name}</code></a></>
  ))}
</nav>

{doc.slots.map((slot) => (
  <>
    <div class="slot-heading-row">
      <h3 id={slotId(slot)}>{slot.name}</h3>
      <span class="slot-badges not-content">
        <span class="slot-badge">{slot.status}</span>
        <span class="slot-badge">{slot.authored}</span>
      </span>
    </div>
    <div class="slot-section-root not-content">
      <p class="slot-summary">{slot.summary}</p>

      <section class="slot-snippet">
        <p class="slot-snippet-label">Markup</p>
        <EcCode code={slotMarkup(slot)} lang="html" meta="slot-links" frame="none" />
      </section>

      {hasRows(slot.inputRows) && (
        <section class="slot-section">

          <div class="slot-disclosure-shell not-content">
            <div class="slot-disclosure-head" aria-hidden="true">
              <span>Prop</span>
              <span>Type</span>
              <span>Default</span>
              <span></span>
            </div>
            <div class="slot-disclosure-list">
              {slot.inputRows?.map((row) => (
                <details class="slot-disclosure-item">
                  <summary class="slot-disclosure-summary">
                    <div class="slot-disclosure-row">
                      <span class="slot-disclosure-prop"><code>{parseName(row.name).dataAttr ?? parseName(row.name).prop}</code></span>
                      <span class="slot-rich-text">
                        {row.type ? inlineParts(row.type).map((part) =>
                          part.code ? <code>{part.text}</code> : <>{part.text}</>
                        ) : "—"}
                      </span>
                      <span class="slot-rich-text slot-disclosure-default">
                        {row.default ? inlineParts(row.default).map((part) =>
                          part.code ? <code>{part.text}</code> : <>{part.text}</>
                        ) : "—"}
                      </span>
                      <span class="slot-disclosure-chevron" aria-hidden="true">
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M6 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      </span>
                    </div>
                  </summary>
                  <div class="slot-disclosure-panel">
                    <div class="slot-disclosure-detail">
                      <p class="slot-disclosure-description slot-rich-text">
                        {inlineParts(row.description).map((part) =>
                          part.code ? <code>{part.text}</code> : <>{part.text}</>
                        )}
                      </p>
                      <dl class="slot-disclosure-meta">
                        {parseName(row.name).dataAttr && (
                          <div>
                            <dt>JS option</dt>
                            <dd><code>{parseName(row.name).prop}</code></dd>
                          </div>
                        )}
                        <div>
                          <dt>Type</dt>
                          <dd class="slot-rich-text">
                            {row.type ? inlineParts(row.type).map((part) =>
                              part.code ? <code>{part.text}</code> : <>{part.text}</>
                            ) : "—"}
                          </dd>
                        </div>
                        <div>
                          <dt>Default</dt>
                          <dd class="slot-rich-text">
                            {row.default ? inlineParts(row.default).map((part) =>
                              part.code ? <code>{part.text}</code> : <>{part.text}</>
                            ) : "—"}
                          </dd>
                        </div>
                      </dl>
                    </div>
                  </div>
                </details>
              ))}
            </div>
          </div>
        </section>
      )}

      {hasRows(slot.outputRows) && (
        <section class="slot-section">
          <DocTable fixed>
          <table>
            <colgroup>
              <col class="slot-col-wide" />
              <col />
            </colgroup>
            <thead>
              <tr>
                <th>Attribute</th>
                <th>Description</th>
              </tr>
            </thead>
            <tbody>
              {slot.outputRows?.map((row) => (
                <tr>
                  <td class="slot-rich-text">
                    {inlineParts(row.name).map((part) =>
                      part.code ? <code>{part.text}</code> : <>{part.text}</>
                    )}
                  </td>
                  <td class="slot-rich-text">
                    {inlineParts(row.description).map((part) =>
                      part.code ? <code>{part.text}</code> : <>{part.text}</>
                    )}
                    {row.values && <> — {inlineParts(row.values).map((part) =>
                      part.code ? <code>{part.text}</code> : <>{part.text}</>
                    )}</>}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
          </DocTable>
        </section>
      )}

      {hasRows(slot.cssVariables) && (
        <section class="slot-section">
          <DocTable fixed>
          <table>
            <colgroup>
              <col class="slot-col-wide" />
              <col />
            </colgroup>
            <thead>
              <tr>
                <th>CSS variable</th>
                <th>Description</th>
              </tr>
            </thead>
            <tbody>
              {slot.cssVariables?.map((row) => (
                <tr>
                  <td class="slot-rich-text">
                    {inlineParts(row.name).map((part) =>
                      part.code ? <code>{part.text}</code> : <>{part.text}</>
                    )}
                  </td>
                  <td class="slot-rich-text">
                    {inlineParts(row.description).map((part) =>
                      part.code ? <code>{part.text}</code> : <>{part.text}</>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
          </DocTable>
        </section>
      )}

      {slot.notes && slot.notes.length > 0 && (
        <section class="slot-section">

          <ul>
            {slot.notes.map((note) => (
              <li class="slot-rich-text">
                {inlineParts(note).map((part) =>
                  part.code ? <code>{part.text}</code> : <>{part.text}</>
                )}
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
  </>
))}

<h3 id="api-controller">Controller</h3>
{controllerRows.length > 0 ? (
  <DocTable>
    <table>
      <thead>
        <tr>
          <th>API</th>
          <th>Description</th>
        </tr>
      </thead>
      <tbody>
        {controllerRows.map((entry) => (
          <tr>
            <td><code>{controllerLabel(entry)}</code></td>
            <td>{entry.description}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </DocTable>
) : (
  <p>No controller API is documented for this component.</p>
)}

<h3 id="api-events">Events</h3>
{outboundEvents.length > 0 && (
  <>
    <h4>Outbound events</h4>
    <DocTable>
      <table>
        <thead>
          <tr>
            <th>Event</th>
            <th>Detail</th>
            <th>Description</th>
          </tr>
        </thead>
        <tbody>
          {outboundEvents.map((event) => (
            <tr>
              <td><code>{eventLabel(event)}</code></td>
              <td>{event.detail}</td>
              <td>{event.description}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </DocTable>
  </>
)}

{inboundEvents.length > 0 && (
  <>
    <h4>Inbound events</h4>
    <DocTable>
      <table>
        <thead>
          <tr>
            <th>Event</th>
            <th>Detail</th>
            <th>Description</th>
          </tr>
        </thead>
        <tbody>
          {inboundEvents.map((event) => (
            <tr>
              <td><code>{eventLabel(event)}</code></td>
              <td>{event.detail}</td>
              <td>{event.description}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </DocTable>
  </>
)}

<h2 id="references">References</h2>
<ul>
  {doc.references.map((reference) => (
    <li>
      <a href={reference.href}>{reference.label}</a>
    </li>
  ))}
</ul>

<style>
  .anatomy-markup {
    margin-block: 1.5rem;
  }

  .slot-index {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.5rem;
    margin-block: 1.5rem;
  }

  .slot-index a {
    text-decoration: none;
    color: var(--sl-color-text-accent);
  }

  .slot-index a:hover {
    text-decoration: underline;
  }

  .slot-index code {
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-sm);
  }

  .slot-index-sep {
    color: var(--sl-color-gray-4);
    user-select: none;
  }

  .api-shell {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
    align-items: start;
    margin-block: 1.5rem;
  }

  .api-shell .expressive-code,
  .api-shell .astro-code {
    margin: 0;
  }

  .api-shell .frame,
  .api-shell .astro-code {
    border: 1px solid var(--sl-color-gray-6);
    border-radius: 0.85rem;
    background: color-mix(in srgb, var(--sl-color-bg) 98%, var(--sl-color-gray-7) 2%);
  }

  .api-shell .frame .header {
    display: none;
  }

  .api-shell-label {
    margin-bottom: 0.5rem;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .slot-heading-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 3rem;
    padding-top: 2rem;
  }

  .slot-heading-row:first-of-type {
    border-top: none;
    padding-top: 0;
    margin-top: 1.5rem;
  }

  .slot-heading-row h3 {
    margin-top: 0;
    margin-bottom: 0;
  }

  .slot-badges {
    display: inline-flex;
    gap: 0.4rem;
    flex-shrink: 0;
  }

  .slot-summary {
    margin: 0 0 1rem;
    color: var(--sl-color-gray-2);
  }

  .slot-badge {
    color: var(--sl-color-gray-3);
    font-size: 0.625rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    padding: 0.2rem 0.55rem;
    border-radius: 0.35rem;
    background: color-mix(in srgb, var(--sl-color-gray-6) 40%, transparent);
  }

  .slot-snippet {
    margin-bottom: 1.25rem;
  }

  .slot-snippet-label {
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-xs);
    letter-spacing: 0.06em;
    margin: 0 0 0.45rem;
    text-transform: uppercase;
  }

  .slot-snippet-label + .expressive-code,
  .api-shell-label + .expressive-code {
    margin-top: 0 !important;
  }

  .slot-snippet .expressive-code,
  .slot-snippet .astro-code {
    margin: 0;
  }

  .slot-snippet .frame,
  .slot-snippet .astro-code {
    border: 1px solid var(--sl-color-gray-6);
    border-radius: 0.85rem;
    background: color-mix(in srgb, var(--sl-color-bg) 98%, var(--sl-color-gray-7) 2%);
  }

  .slot-snippet .frame .header {
    display: none;
  }

  .slot-snippet .frame pre,
  .slot-snippet .astro-code {
    margin: 0;
    font-size: 0.95rem;
  }

  .slot-section-root {
    margin-bottom: 3rem;
  }

  .slot-section + .slot-section {
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--sl-color-gray-6);
  }

  .slot-disclosure-shell {
    border: 1px solid var(--sl-color-gray-6);
    border-radius: 0.85rem;
    background: color-mix(in srgb, var(--sl-color-bg) 98%, var(--sl-color-gray-7) 2%);
    overflow: hidden;
    font-size: var(--sl-text-xs);
  }

  .slot-disclosure-head,
  .slot-disclosure-row {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr) minmax(0, 1.5fr) 2rem;
    gap: 1rem;
    align-items: center;
  }

  .slot-disclosure-head {
    padding: 0.85rem 0.95rem;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-xs);
    text-transform: uppercase;
    background: color-mix(in srgb, var(--sl-color-bg) 92%, var(--sl-color-accent-low) 8%);
    border-bottom: 1px solid var(--sl-color-gray-6);
    font-weight: 700;
  }

  .slot-disclosure-item + .slot-disclosure-item {
    border-top: 1px solid var(--sl-color-gray-6);
  }

  .slot-disclosure-summary {
    list-style: none;
    cursor: pointer;
    padding: 0.85rem 0.95rem;
    transition: background-color 160ms ease;
  }

  .slot-disclosure-item:hover .slot-disclosure-summary,
  .slot-disclosure-item[open] .slot-disclosure-summary {
    background: color-mix(in srgb, var(--sl-color-bg) 95%, var(--sl-color-accent-low) 5%);
  }

  .slot-disclosure-chevron {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--sl-color-gray-3);
    transition: transform 160ms ease;
  }

  .slot-disclosure-item[open] .slot-disclosure-chevron {
    transform: rotate(90deg);
  }

  .slot-disclosure-shell {
    font-family: var(--sl-font-mono);
  }

  .slot-disclosure-head {
    font-family: var(--sl-font);
  }

  .slot-disclosure-description {
    font-family: var(--sl-font);
  }

  .slot-disclosure-meta dt {
    font-family: var(--sl-font);
  }

  .slot-disclosure-prop code {
    font-weight: 500;
    font-family: inherit;
    font-size: inherit;
    background: none;
    padding: 0;
  }

  .slot-disclosure-meta code {
    font-family: inherit;
    font-size: inherit;
    background-color: var(--sl-color-bg-inline-code);
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
  }

  .slot-disclosure-row > span {
    min-width: 0;
  }

  .slot-disclosure-row .slot-rich-text {
    overflow-wrap: break-word;
    word-break: normal;
  }

  .slot-disclosure-row .slot-rich-text code {
    overflow-wrap: break-word;
    word-break: normal;
  }

  .slot-disclosure-panel {
    padding: 0 0.95rem 0.95rem;
    border-top: 1px solid var(--sl-color-gray-6);
    background: color-mix(in srgb, var(--sl-color-bg) 95%, var(--sl-color-accent-low) 5%);
  }

  .slot-disclosure-detail {
    padding-top: 0.95rem;
  }

  .slot-disclosure-description {
    margin: 0;
  }

  .slot-disclosure-meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr));
    gap: 0.85rem;
    margin: 0;
    padding-top: 0.95rem;
  }

  .slot-disclosure-meta dt {
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-xs);
    letter-spacing: 0.06em;
    margin: 0;
    text-transform: uppercase;
  }

  .slot-disclosure-meta dd {
    margin: 0.35rem 0 0;
  }

  .slot-col-wide {
    width: 34%;
  }

  .slot-col-type {
    width: 14%;
  }

  .slot-col-default {
    width: 14%;
  }

  .slot-rich-text {
    line-height: 1.6;
    overflow-wrap: anywhere;
  }

  .slot-rich-text code {
    white-space: normal;
    overflow-wrap: anywhere;
  }

  @media (max-width: 50rem) {
    .slot-disclosure-head,
    .slot-disclosure-row {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1.5fr) minmax(0, 1fr) 2rem;
      gap: 0.75rem;
      align-items: start;
    }

    .slot-disclosure-meta {
      grid-template-columns: 1fr;
      gap: 0.45rem;
    }
  }

  @media (max-width: 32rem) {
    .slot-disclosure-head span:nth-child(3),
    .slot-disclosure-row > .slot-disclosure-default {
      display: none;
    }

    .slot-disclosure-head,
    .slot-disclosure-row {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1.5fr) 2rem;
    }
  }
</style>
