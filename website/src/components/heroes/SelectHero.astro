---
import ComponentHero from "../docs/ComponentHero.astro";

const cssCode = `<div data-slot="select" data-placeholder="Pick a fruit..." class="select-root">
  <button data-slot="select-trigger" class="select-trigger">
    <span data-slot="select-value"></span>
    <span class="select-icon">▼</span>
  </button>
  <div data-slot="select-content" class="select-content" hidden>
    <div data-slot="select-item" data-value="apple" data-label="Apple" class="select-item">
      Apple<span class="select-check">✓</span>
    </div>
    <div data-slot="select-item" data-value="banana" data-label="Banana" class="select-item">
      Banana<span class="select-check">✓</span>
    </div>
    <div data-slot="select-item" data-value="orange" data-label="Orange" class="select-item">
      Orange<span class="select-check">✓</span>
    </div>
  </div>
</div>

<style>
  .select-root { display: inline-block; }
  .select-trigger {
    display: flex; align-items: center; gap: 0.5rem;
    padding: 0.5rem 1rem; min-width: 180px;
    background: #1a1a1a; color: #faf9f7; border: none; cursor: pointer;
  }
  .select-icon { margin-left: auto; font-size: 0.75rem; }
  .select-content {
    background: #faf9f7; border: 1px solid #ccc;
    min-width: 180px; padding: 0.25rem; z-index: 50;
  }
  .select-item {
    display: flex; align-items: center; padding: 0.375rem 0.5rem;
    cursor: pointer; font-size: 0.875rem;
  }
  .select-check { margin-left: auto; visibility: hidden; }
  .select-item[data-selected] .select-check { visibility: visible; }
  .select-item[data-highlighted] { background: #e5e5e5; }
</style>`;

const tailwindCode = `<div data-slot="select" data-placeholder="Pick a fruit..."
     class="inline-block relative">
  <button data-slot="select-trigger"
          class="flex items-center gap-2 px-4 py-2 min-w-[180px]
                 bg-gray-900 text-white border-none cursor-pointer">
    <span data-slot="select-value"></span>
    <span class="ml-auto text-xs">▼</span>
  </button>
  <div data-slot="select-content"
       class="bg-white border border-gray-300 min-w-[180px]
              p-1 z-50 rounded-lg shadow-lg"
       hidden>
    <div data-slot="select-item" data-value="apple" data-label="Apple"
         class="group flex items-center px-2 py-1.5 text-sm rounded
                cursor-pointer data-[highlighted]:bg-gray-100">
      Apple<span class="ml-auto invisible group-data-[selected]:visible">✓</span>
    </div>
    <div data-slot="select-item" data-value="banana" data-label="Banana"
         class="group flex items-center px-2 py-1.5 text-sm rounded
                cursor-pointer data-[highlighted]:bg-gray-100">
      Banana<span class="ml-auto invisible group-data-[selected]:visible">✓</span>
    </div>
    <div data-slot="select-item" data-value="orange" data-label="Orange"
         class="group flex items-center px-2 py-1.5 text-sm rounded
                cursor-pointer data-[highlighted]:bg-gray-100">
      Orange<span class="ml-auto invisible group-data-[selected]:visible">✓</span>
    </div>
  </div>
</div>`;
---

<ComponentHero cssCode={cssCode} tailwindCode={tailwindCode}>
  <div slot="preview-css" data-slot="select" data-placeholder="Pick a fruit..." class="select-root">
    <button data-slot="select-trigger" class="select-trigger">
      <span data-slot="select-value"></span>
      <span class="select-icon">▼</span>
    </button>
    <div data-slot="select-content" class="select-content" hidden>
      <div data-slot="select-item" data-value="apple" data-label="Apple" class="select-item">Apple<span class="select-check">✓</span></div>
      <div data-slot="select-item" data-value="banana" data-label="Banana" class="select-item">Banana<span class="select-check">✓</span></div>
      <div data-slot="select-item" data-value="orange" data-label="Orange" class="select-item">Orange<span class="select-check">✓</span></div>
    </div>
  </div>
  <div slot="preview-tailwind" data-slot="select" data-placeholder="Pick a fruit..." class="inline-block relative">
    <button data-slot="select-trigger" class="flex items-center gap-2 px-4 py-2 min-w-[180px] bg-gray-900 text-white border-none cursor-pointer">
      <span data-slot="select-value"></span>
      <span class="ml-auto text-xs">▼</span>
    </button>
    <div data-slot="select-content" class="bg-white border border-gray-300 min-w-[180px] p-1 z-50 rounded-lg shadow-lg" hidden>
      <div data-slot="select-item" data-value="apple" data-label="Apple" class="group flex items-center px-2 py-1.5 text-sm rounded cursor-pointer data-[highlighted]:bg-gray-100">Apple<span class="ml-auto invisible group-data-[selected]:visible">✓</span></div>
      <div data-slot="select-item" data-value="banana" data-label="Banana" class="group flex items-center px-2 py-1.5 text-sm rounded cursor-pointer data-[highlighted]:bg-gray-100">Banana<span class="ml-auto invisible group-data-[selected]:visible">✓</span></div>
      <div data-slot="select-item" data-value="orange" data-label="Orange" class="group flex items-center px-2 py-1.5 text-sm rounded cursor-pointer data-[highlighted]:bg-gray-100">Orange<span class="ml-auto invisible group-data-[selected]:visible">✓</span></div>
    </div>
  </div>
</ComponentHero>
