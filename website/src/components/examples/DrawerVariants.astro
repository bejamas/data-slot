---
import { Code } from "astro:components";
import ExampleBlock from "../ExampleBlock.astro";
import styles from "./drawer-variants.css?raw";
import "./drawer-variants.css";

const variants = [
  {
    id: "side",
    label: "right-side drawer",
    trigger: "Packing checklist",
    title: "Pack for the weekend",
    description: "Tick off the essentials, then swipe right or use the close button.",
    body: `<label><input type="checkbox" checked /> Travel documents</label>
          <label><input type="checkbox" /> Phone charger</label>
          <label><input type="checkbox" /> Comfortable shoes</label>
          <label><input type="checkbox" /> Rain jacket</label>`,
    close: "Close checklist",
    note: "A full-height side panel with horizontal swipe-to-dismiss and interactive form controls.",
    direction: "right",
  },
  {
    id: "basic",
    label: "basic bottom drawer",
    trigger: "View booking",
    title: "Your weekend in Warsaw",
    description: "A compact drawer that sizes to its content. Click outside, press Escape, or use Done to close.",
    body: "<p>Two guests · Three nights<br>Check-in Friday, 18 September</p>",
    close: "Done",
    note: "The sheet fits a short booking summary without a fixed height.",
    direction: "down",
  },
  {
    id: "scroll",
    label: "scrollable drawer with a fixed footer",
    trigger: "Explore itinerary",
    title: "A day around Warsaw",
    description: "Scroll through the stops. The close button stays visible; drag the handle down to dismiss.",
    body: [
      ["09:00", "Breakfast in Śródmieście", "Start with coffee and a fresh pastry before heading into the city."],
      ["10:00", "Old Town walk", "Explore the market square, quiet courtyards, and the city walls."],
      ["11:00", "Royal Castle", "Leave time to explore the galleries and the gardens by the river."],
      ["12:30", "Lunch at a milk bar", "Try pierogi and a bowl of soup at a traditional neighborhood spot."],
      ["14:00", "Vistula boulevards", "Follow the riverside promenade and pause for a view across the water."],
      ["15:00", "Copernicus Science Centre", "Spend the afternoon trying hands-on exhibits and experiments."],
      ["17:00", "Łazienki Park", "Wander the tree-lined paths around the palace and its gardens."],
      ["19:00", "Dinner in Powiśle", "Finish the day with dinner and a relaxed walk through the neighborhood."],
    ].map(([time, title, description]) => `<article><strong>${time} · ${title}</strong><p>${description}</p></article>`).join("\n          "),
    close: "Close itinerary",
    note: "A 75dvh sheet with an independently scrolling body and a footer outside the scroll container.",
    direction: "down",
  },
] as const;

const css = {
  trigger: "drawer-showcase-trigger",
  backdrop: "drawer-showcase-backdrop",
  viewport: "drawer-showcase-viewport",
  popup: "drawer-showcase-popup",
  handle: "drawer-showcase-handle",
  content: "drawer-showcase-content",
  title: "drawer-showcase-title",
  description: "drawer-showcase-description",
  footer: "drawer-showcase-footer",
  close: "drawer-showcase-close",
};
const tailwind = {
  trigger: "cursor-pointer border-0 bg-[#1a1a1a] px-4 py-2 text-[#faf9f7]",
  backdrop: "fixed inset-0 z-[110] bg-black/45 opacity-[calc(1-var(--drawer-swipe-progress,0))] transition-opacity duration-300 data-[starting-style]:opacity-0 data-[ending-style]:opacity-0 data-[swiping]:transition-none hidden:hidden",
  viewport: "pointer-events-none fixed inset-0 z-[111] flex h-dvh w-screen items-end data-[swipe-direction=right]:justify-end hidden:hidden",
  popup: "pointer-events-auto mx-auto flex max-h-[90dvh] w-full flex-col overflow-hidden rounded-t-2xl border border-[#ccc] bg-[#faf9f7] text-[#1a1a1a] shadow-2xl transition-transform duration-300 [transform:translateY(var(--drawer-swipe-movement-y,0px))] data-[starting-style]:[transform:translateY(100%)] data-[ending-style]:[transform:translateY(100%)] data-[swiping]:transition-none hidden:hidden",
  handle: "flex shrink-0 touch-none justify-center p-4 before:h-1 before:w-12 before:rounded-full before:bg-[#ccc]",
  content: "grid min-h-0 gap-4 overflow-y-auto overscroll-contain px-6 pb-6 [&_p]:m-0 [&_article]:border-b [&_article]:border-[#ccc] [&_article]:pb-4 [&_input]:mr-2",
  title: "m-0 text-lg font-bold",
  description: "m-0 text-sm leading-relaxed text-[#666]",
  footer: "shrink-0 border-t border-[#ccc] p-4",
  close: "w-full cursor-pointer border border-[#ccc] bg-transparent px-3 py-2 hover:bg-[#f0eeeb]",
};

function markup(variant: typeof variants[number], mode: "css" | "tailwind") {
  const classes = mode === "css" ? css : tailwind;
  const hasHandle = variant.id === "scroll";
  const contentPadding = mode === "tailwind" && !hasHandle ? " pt-6" : "";
  const size = mode === "css" ? `drawer-showcase-${variant.id}` : variant.id === "side"
    ? "!m-0 !h-dvh !max-h-none !max-w-sm !rounded-none ![transform:translateX(var(--drawer-swipe-movement-x,0px))] data-[starting-style]:![transform:translateX(100%)] data-[ending-style]:![transform:translateX(100%)]"
    : variant.id === "scroll" ? "h-[75dvh]" : "";
  return `<div id="drawer-${variant.id}-${mode}" data-slot="drawer" data-swipe-direction="${variant.direction}">
  <button type="button" data-slot="drawer-trigger" class="${classes.trigger}">${variant.trigger}</button>
  <div data-slot="drawer-portal">
    <div data-slot="drawer-backdrop" class="${classes.backdrop}" hidden></div>
    <div data-slot="drawer-viewport" class="${classes.viewport}" hidden>
      <div data-slot="drawer-popup" class="${classes.popup} ${size}" hidden>
        ${hasHandle ? `<div class="${classes.handle}" aria-hidden="true"></div>\n        ` : ""}<div data-slot="drawer-content" class="${classes.content}${contentPadding}">
          <h2 data-slot="drawer-title" class="${classes.title}">${variant.title}</h2>
          <p data-slot="drawer-description" class="${classes.description}">${variant.description}</p>
          ${variant.body}
        </div>
        <footer class="${classes.footer}">
          <button type="button" data-slot="drawer-close" class="${classes.close}">${variant.close}</button>
        </footer>
      </div>
    </div>
  </div>
</div>`;
}

function source(variant: typeof variants[number], mode: "css" | "tailwind") {
  return `${markup(variant, mode)}

<script type="module">
  import { createDrawer } from "@data-slot/drawer";
  createDrawer(document.querySelector("#drawer-${variant.id}-${mode}"));
</script>${mode === "css" ? `\n\n<style>\n${styles}</style>` : ""}`;
}
---

{variants.map((variant) => (
  <ExampleBlock label={variant.label}>
    <Fragment slot="preview-css" set:html={markup(variant, "css")} />
    <Fragment slot="preview-tailwind" set:html={markup(variant, "tailwind")} />
    <p slot="note" class="mt-4 text-sm text-[#666]">{variant.note}</p>
    <Code slot="code-css" code={source(variant, "css")} lang="html" theme="vitesse-light" />
    <Code slot="code-tailwind" code={source(variant, "tailwind")} lang="html" theme="vitesse-light" />
  </ExampleBlock>
))}
