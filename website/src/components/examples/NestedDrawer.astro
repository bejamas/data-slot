---
import { Code } from "astro:components";
import ExampleBlock from "../ExampleBlock.astro";
import styles from "./drawer-variants.css?raw";
import nestedStyles from "./nested-drawer.css?raw";
import "./drawer-variants.css";
import "./nested-drawer.css";

const css = {
  trigger: "drawer-showcase-trigger",
  backdrop: "drawer-showcase-backdrop",
  viewport: "drawer-showcase-viewport",
  popup: "drawer-showcase-popup drawer-nested-popup",
  content: "drawer-showcase-content",
  title: "drawer-showcase-title",
  description: "drawer-showcase-description",
  footer: "drawer-showcase-footer",
  close: "drawer-showcase-close",
};
const tailwind = {
  trigger: "cursor-pointer border-0 bg-[#1a1a1a] px-4 py-2 text-[#faf9f7]",
  backdrop: "fixed inset-0 z-[110] bg-black/45 opacity-[calc(1-var(--drawer-swipe-progress,0))] transition-opacity duration-300 data-[starting-style]:opacity-0 data-[ending-style]:opacity-0 data-[swiping]:transition-none hidden:hidden",
  viewport: "pointer-events-none fixed inset-0 z-[111] flex h-dvh w-screen items-end data-[swipe-direction=right]:justify-end hidden:hidden",
  popup: "pointer-events-auto m-0 flex h-dvh w-full max-w-sm flex-col overflow-hidden border border-[#ccc] bg-[#faf9f7] text-[#1a1a1a] shadow-2xl origin-right transition-transform duration-300 [transform:translateX(var(--drawer-swipe-movement-x,0px))] data-[nested-drawer-open]:[transform:translateX(-1rem)_scale(0.96)] data-[nested]:max-w-[22rem] data-[starting-style]:[transform:translateX(100%)] data-[ending-style]:[transform:translateX(100%)] data-[swiping]:transition-none hidden:hidden",
  content: "grid min-h-0 flex-1 content-start gap-4 overflow-y-auto overscroll-contain p-6 [&_p]:m-0 [&_input]:mr-2",
  title: "m-0 text-lg font-bold",
  description: "m-0 text-sm leading-relaxed text-[#666]",
  footer: "shrink-0 border-t border-[#ccc] p-4",
  close: "w-full cursor-pointer border border-[#ccc] bg-transparent px-3 py-2 hover:bg-[#f0eeeb]",
};

function markup(mode: "css" | "tailwind") {
  const c = mode === "css" ? css : tailwind;
  const childBackdrop = mode === "css" ? "drawer-nested-backdrop" : "!z-[120] !bg-transparent";
  const childViewport = mode === "css" ? "drawer-nested-viewport" : "!z-[121]";
  return `<div id="drawer-nested-${mode}" data-slot="drawer" data-swipe-direction="right">
  <button type="button" data-slot="drawer-trigger" class="${c.trigger}">Trip details</button>
  <div data-slot="drawer-portal">
    <div data-slot="drawer-backdrop" class="${c.backdrop}" hidden></div>
    <div data-slot="drawer-viewport" class="${c.viewport}" hidden>
      <div data-slot="drawer-popup" class="${c.popup}" hidden>
        <div data-slot="drawer-content" class="${c.content}">
          <h2 data-slot="drawer-title" class="${c.title}">Your upcoming trip</h2>
          <p data-slot="drawer-description" class="${c.description}">Three nights in Warsaw. Set your travel reminders without leaving these details.</p>
          <p>Two guests · Check-in Friday, 18 September</p>
          <div id="drawer-nested-child-${mode}" data-slot="drawer" data-swipe-direction="right">
            <button type="button" data-slot="drawer-trigger" class="${c.trigger}">Travel reminders</button>
            <div data-slot="drawer-portal">
              <div data-slot="drawer-backdrop" class="${c.backdrop} ${childBackdrop}" hidden></div>
              <div data-slot="drawer-viewport" class="${c.viewport} ${childViewport}" hidden>
                <div data-slot="drawer-popup" class="${c.popup}" hidden>
                  <div data-slot="drawer-content" class="${c.content}">
                    <h2 data-slot="drawer-title" class="${c.title}">Travel reminders</h2>
                    <p data-slot="drawer-description" class="${c.description}">Choose what to remember before you leave.</p>
                    <label><input type="checkbox" checked /> Check in online</label>
                    <label><input type="checkbox" /> Download offline maps</label>
                  </div>
                  <footer class="${c.footer}">
                    <button type="button" data-slot="drawer-close" class="${c.close}">Back to trip</button>
                  </footer>
                </div>
              </div>
            </div>
          </div>
        </div>
        <footer class="${c.footer}">
          <button type="button" data-slot="drawer-close" class="${c.close}">Close trip details</button>
        </footer>
      </div>
    </div>
  </div>
</div>`;
}

function source(mode: "css" | "tailwind") {
  return `${markup(mode)}

<script type="module">
  import { createDrawer } from "@data-slot/drawer";
  createDrawer(document.querySelector("#drawer-nested-${mode}"));
  createDrawer(document.querySelector("#drawer-nested-child-${mode}"));
</script>${mode === "css" ? `\n\n<style>\n${styles}\n${nestedStyles}</style>` : ""}`;
}
---

<ExampleBlock label="nested drawers">
  <Fragment slot="preview-css" set:html={markup("css")} />
  <Fragment slot="preview-tailwind" set:html={markup("tailwind")} />
  <p slot="note" class="mt-4 text-sm text-[#666]">
    Both drawers slide in from the right with one visible backdrop. Open Travel reminders inside Trip details, then swipe right,
    press Escape, or use Back to trip
    to close only the inner drawer. Focus returns to its trigger in the parent drawer.
  </p>
  <Code slot="code-css" code={source("css")} lang="html" theme="vitesse-light" />
  <Code slot="code-tailwind" code={source("tailwind")} lang="html" theme="vitesse-light" />
</ExampleBlock>
