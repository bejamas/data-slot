          Billing Portal
          <span data-slot="command-shortcut" class="command-shortcut">Soon</span>
        </div>
      </div>
    </div>
  </div>

  <label slot="preview-tailwind" for="command-inline-tw" class="mb-2 block text-xs font-semibold uppercase tracking-wider text-stone-600">
    Workspace
  </label>
  <div
    slot="preview-tailwind"
    data-slot="command"
    data-label="Workspace Command Menu"
    class="w-full max-w-md border border-stone-300 bg-linear-to-b from-stone-50 to-stone-100 shadow-xl"
