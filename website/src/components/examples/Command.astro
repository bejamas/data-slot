        placeholder="Search commands..."
      />
    </div>
    <div data-slot="command-list" class="max-h-72 overflow-auto p-1.5">
      <div data-slot="command-empty" class="px-3 py-4 text-center text-sm text-stone-600" hidden>No results.</div>
      <div data-slot="command-group">
        <div data-slot="command-group-heading" class="px-3 py-2 text-xs font-bold uppercase tracking-wider text-stone-600">
          Project
        </div>
        <div
          data-slot="command-item"
          class="flex cursor-default items-center gap-3 px-3 py-2.5 text-sm text-stone-950 data-selected:bg-stone-200"
        >
          Open Dashboard
          <span data-slot="command-shortcut" class="ml-auto text-xs uppercase tracking-wider text-stone-600">↵</span>
        </div>
        <div
          data-slot="command-item"
          data-keywords="invite,team"
          class="flex cursor-default items-center gap-3 px-3 py-2.5 text-sm text-stone-950 data-selected:bg-stone-200"
        >
          Invite Teammate
          <span data-slot="command-shortcut" class="ml-auto text-xs uppercase tracking-wider text-stone-600">⌘I</span>
        </div>
      </div>
      <div data-slot="command-separator" class="my-1 h-px bg-stone-300/70"></div>
      <div data-slot="command-group">
        <div data-slot="command-group-heading" class="px-3 py-2 text-xs font-bold uppercase tracking-wider text-stone-600">
          Preferences
        </div>
        <div
          data-slot="command-item"
          data-value="settings"
          class="flex cursor-default items-center gap-3 px-3 py-2.5 text-sm text-stone-950 data-selected:bg-stone-200"
        >
          Open Settings
          <span data-slot="command-shortcut" class="ml-auto text-xs uppercase tracking-wider text-stone-600">⌘,</span>
        </div>
        <div
          data-slot="command-item"
          data-disabled
          class="flex cursor-default items-center gap-3 px-3 py-2.5 text-sm text-stone-400"
